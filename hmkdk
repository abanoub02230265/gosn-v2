<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>الواجهة الرئيسية - مشاريعي</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --main:#ff6b6b;         /* أحمر فاتح */
      --main-dark:#d64545;    /* أحمر غامق */
      --accent:#ffd93d;       /* أصفر */
      --card-bg:#fff;
      --shadow:0 6px 18px rgba(0,0,0,0.12);
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Cairo',sans-serif;background:#f9fafc;color:#222;overflow-x:hidden}

    header{
      background:linear-gradient(180deg,var(--main) 0%,var(--main-dark) 100%);
      color:#fff;padding:14px 16px;
      display:flex;align-items:center;justify-content:space-between;
      box-shadow:var(--shadow);
    }
    header h1{margin:0;font-weight:700;font-size:22px;letter-spacing:1px}
    header button{background:none;border:none;color:#fff;font-size:28px;cursor:pointer;transition:0.3s}
    header button:hover{transform:rotate(90deg)}

    .container{max-width:500px;margin:20px auto;padding:0 14px;display:flex;flex-direction:column;gap:18px}

    .card{
      background:var(--card-bg);border-radius:18px;box-shadow:var(--shadow);
      padding:20px;cursor:pointer;transition:transform 0.25s, box-shadow 0.25s;
      position:relative;overflow:hidden;
    }
    .card::before{
      content:"";position:absolute;top:0;left:-100%;width:100%;height:100%;
      background:linear-gradient(120deg,transparent,rgba(255,255,255,0.3),transparent);
      transition:0.5s;
    }
    .card:hover::before{left:100%}
    .card:hover{transform:translateY(-6px);box-shadow:0 8px 22px rgba(0,0,0,0.18)}
    .card h2{font-size:18px;margin-bottom:8px;color:var(--main)}
    .card p{font-size:14px;opacity:0.8}

    /* 🔥 البنر */
    .banner{
      position:relative;border-radius:18px;overflow:hidden;
      box-shadow:var(--shadow);cursor:pointer;
      height:5cm;
    }
    .slides{display:flex;width:300%;height:100%;transition:transform 0.5s ease}
    .slides img{width:100%;height:100%;object-fit:cover;flex-shrink:0;filter:brightness(0.9)}
    .banner::after{
      content:"◀ ▶";position:absolute;bottom:8px;right:10px;
      color:#fff;font-size:18px;opacity:0.7;animation:blink 1.2s infinite alternate;
    }
    @keyframes blink{from{opacity:0.3}to{opacity:0.9}}

    .button{
      display:block;background:var(--main);color:#fff;padding:14px;text-align:center;
      border-radius:12px;text-decoration:none;box-shadow:var(--shadow);
      font-weight:700;cursor:pointer;transition:0.3s;position:relative;overflow:hidden
    }
    .button::after{
      content:"";position:absolute;top:0;left:-100%;width:100%;height:100%;
      background:linear-gradient(120deg,transparent,rgba(255,255,255,0.4),transparent);
      transition:0.5s;
    }
    .button:hover{background:var(--main-dark);transform:translateY(-2px)}
    .button:hover::after{left:100%}

    nav{
      display:flex;justify-content:space-around;background:#fff;
      box-shadow:0 -2px 8px rgba(0,0,0,0.1);padding:10px;
      position:fixed;bottom:0;width:100%;z-index:1100
    }
    nav a{color:var(--main);text-decoration:none;font-weight:600;font-size:15px;cursor:pointer;transition:0.2s}
    nav a:hover{color:var(--main-dark)}

    /* 🔥 القائمة الجانبية */
    .sidebar{
      position:fixed;top:0;left:-260px;width:260px;height:100%;
      background:#fff;box-shadow:2px 0 12px rgba(0,0,0,0.2);
      transition:0.3s;padding:20px;z-index:1000;
      display:flex;flex-direction:column;gap:14px
    }
    .sidebar.open{left:0}
    .sidebar h2{margin:0 0 10px;font-size:20px;color:var(--main)}
    .sidebar a{padding:10px;border-radius:8px;text-decoration:none;font-weight:600;color:var(--main);transition:0.2s}
    .sidebar a:hover{background:#ffeaea}
    .overlay{
      position:fixed;top:0;left:0;width:100%;height:100%;
      background:rgba(0,0,0,0.4);display:none;z-index:900
    }
    .overlay.show{display:block}

    /* 🌟 Toast */
    .toast {
      position: fixed;bottom: 70px;left: 50%;
      transform: translateX(-50%);background: var(--main);
      color: #fff;padding: 10px 18px;border-radius: 25px;
      font-weight: 600;box-shadow: var(--shadow);
      opacity: 0;pointer-events: none;
      transition: opacity 0.4s ease, transform 0.4s ease;
      z-index: 2000;white-space: nowrap;
    }
    .toast.show {opacity: 1;transform: translateX(-50%) translateY(0)}
  </style>
</head>
<body>
  <header>
    <h1>مشاريعي</h1>
    <button onclick="toggleSidebar()">☰</button>
  </header>

  <main class="container">
    <!-- 🔥 البانر -->
    <div class="banner" id="banner">
      <div class="slides" id="slides">
        <img src="https://picsum.photos/800/200?random=1" alt="صورة 1">
        <img src="https://picsum.photos/800/200?random=2" alt="صورة 2">
        <img src="https://picsum.photos/800/200?random=3" alt="صورة 3">
      </div>
    </div>

    <div class="card" onclick="alert('فتح المشروع 1')">
      <h2>مشروع 1</h2>
      <p>وصف مختصر عن المشروع الأول.</p>
    </div>

    <div class="card" onclick="alert('فتح المشروع 2')">
      <h2>مشروع 2</h2>
      <p>وصف مختصر عن المشروع الثاني.</p>
    </div>

    <a class="button" onclick="alert('تم الضغط على زر التفعيل')">زر تفاعلي</a>
  </main>

  <!-- 🔥 القائمة الجانبية -->
  <div class="sidebar" id="sidebar">
    <h2>القائمة</h2>
    <a href="#" onclick="alert('الإعدادات')">⚙️ الإعدادات</a>
    <a href="#" onclick="alert('الحساب')">👤 الحساب</a>
    <a href="#" onclick="alert('المساعدة')">❓ المساعدة</a>
  </div>
  <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>

  <nav>
    <a href="#" onclick="goHome(event)">🏠 الرئيسية</a>
    <a href="projects.html">📂 المشاريع</a>
  </nav>

  <!-- ✅ Toast element -->
  <div id="toast" class="toast">أنت بالفعل داخل الصفحة الرئيسية</div>

  <script>
    const slides = document.getElementById("slides");
    const banner = document.getElementById("banner");
    let index = 0;
    let autoSlide = setInterval(nextSlide, 3000);
    let startX = 0;

    function showSlide(i){
      slides.style.transform = `translateX(-${i * 100}%)`;
    }
    function nextSlide(){
      index = (index + 1) % 3;
      showSlide(index);
    }
    function prevSlide(){
      index = (index - 1 + 3) % 3;
      showSlide(index);
    }

    // لمس / سحب
    banner.addEventListener("touchstart", e=>{
      clearInterval(autoSlide);
      startX = e.touches[0].clientX;
    });
    banner.addEventListener("touchend", e=>{
      let endX = e.changedTouches[0].clientX;
      let diff = endX - startX;
      if(diff > 50){ prevSlide(); }
      else if(diff < -50){ nextSlide(); }
      autoSlide = setInterval(nextSlide, 3000);
    });

    // فتح/قفل القائمة
    function toggleSidebar(){
      document.getElementById("sidebar").classList.toggle("open");
      document.getElementById("overlay").classList.toggle("show");
    }

    // ✅ Toast function
    function showToast(message){
      const toast = document.getElementById("toast");
      toast.textContent = message;
      toast.classList.add("show");
      setTimeout(()=> toast.classList.remove("show"), 2500);
    }

    // زر الرئيسية
    function goHome(event){
      event.preventDefault();
      if(window.location.pathname.endsWith("index.html") || window.location.pathname === "/" ){
        showToast("أنت بالفعل داخل الصفحة الرئيسية");
      } else {
        window.location.href = "index.html";
      }
    }
  </script>
</body>
</html>
